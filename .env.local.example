# ============================================================
# lab_site 환경변수 예시
# 사용법: cp .env.local.example .env.local 후 실제 값 입력
# ============================================================

# dev 서버 포트 (web_site가 3000을 쓰므로 기본 3100)
PORT=3100

# KCI Open API 키 (scripts/fetch-kci.mjs에서만 사용, 클라이언트에 노출 금지)
KCI_API_KEY=
